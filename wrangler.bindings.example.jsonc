{
  "name": "xeno-v3",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "YOUR_EXISTING_D1_NAME",
      "database_id": "YOUR_EXISTING_D1_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "YOUR_EXISTING_R2_BUCKET"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "damp-cake-d02f.cloudflareaccess.com",
    "ACCESS_AUD": "44cfcfb8fb546deab8a2757845bb2c425393a0566218e428fe89ea58485ff152"
  }
}
